def synthesize_bias(phase: str, kline: dict, position: dict) -> dict:
    """Short / mid / long term bias + 1-line reason."""
    ktype = kline["type"]
    pos_pct = position["in_box_pct"]

    # Short: based on kline + position
    if ktype in ("bearish_rejection", "bearish_pullback") and pos_pct < 50:
        short = "bearish_cautious"
        short_reason = f"rejection at R1 + near support ({pos_pct:.0f}% of box)"
    elif ktype == "bullish_reclaim" and pos_pct > 50:
        short = "bullish_trying"
        short_reason = "reclaim above mid-box"
    elif pos_pct < 30:
        short = "defensive"
        short_reason = f"near box bottom ({pos_pct:.0f}% of box)"
    else:
        short = "neutral"
        short_reason = "mid-box, no clear signal"

    # Mid: based on phase
    mid = {
        "uptrend": "bullish_continuation",
        "base_building": "neutral_consolidation",
        "downtrend_active": "bearish_continuation",
        "breakdown": "bearish_breakdown",
        "range": "neutral",
    }.get(phase, "neutral")
    mid_reason = {
        "uptrend": "higher highs / higher lows",
        "base_building": "consolidating after big move",
        "downtrend_active": "making new lows",
        "breakdown": "key support broken",
        "range": "no clear direction",
    }.get(phase, "")

    # Long: relative to peak
    long = "below_peak_recovery" if pos_pct < 90 else "near_peak"
    long_reason = "still well below all-time peak" if pos_pct < 90 else "near all-time peak"

    return {
        "short": {"bias": short, "reason": short_reason},
        "mid": {"bias": mid, "reason": mid_reason},
        "long": {"bias": long, "reason": long_reason},
    }


def build_scenarios(supports: list[dict], resistances: list[dict], current: float) -> list[dict]:
    """Build the If-Then scenario tree."""
    s1 = supports[0] if supports else None
    s4 = supports[-1] if supports else None
    r1 = resistances[0] if resistances else None
    r3 = next((r for r in resistances if r["label"].startswith("R3")), None)

    scenarios = []
    if s1:
        scenarios.append({"if": f"hold {s1['level']} (KEY support)", "then": f"still range; watch {r1['level'] if r1 else 'next R'} for next test"})
        scenarios.append({"if": f"break {s1['level']} on close", "then": f"target {supports[1]['level'] if len(supports) > 1 else 'next S'} → {supports[2]['level'] if len(supports) > 2 else 'lower'} (short-term bearish)"})
    if s4:
        scenarios.append({"if": f"break {s4['level']} (crash low)", "then": f"base invalidation; mid-term bearish"})
    if r1:
        scenarios.append({"if": f"reclaim {r1['level']} on close", "then": f"short-term bullish; next test {resistances[1]['level'] if len(resistances) > 1 else 'next R'}"})
    if r3:
        scenarios.append({"if": f"break {r3['level']} (box top)", "then": "leave consolidation; mid-term recovery, watch next R"})
    return scenarios


