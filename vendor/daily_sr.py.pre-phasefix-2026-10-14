# Orchestrator
# =============================================================================

def _compute_patterns(df, window: int = 90, min_gap_days: int = 6,
                      max_n: int = 5) -> list[dict]:
    """Confirmed candlestick patterns over the last `window` bars.

    Emitted into the JSON snapshot so the interactive canvas chart can draw
    them. Same confirmed-only / de-cluttered rules as the PNG renderer, so the
    two views agree. Never used by the action plan — annotation only.
    """
    try:
        import candle_patterns as _cp
    except Exception:
        return []
    try:
        frame = df.rename(columns={"date": "time"})[["open", "high", "low", "close", "time"]]
        hits = _cp.detect(frame)
    except Exception:
        return []
    if hits is None or len(hits) == 0:
        return []

    dates = [pd.Timestamp(d) for d in df["date"]]
    n = len(dates)
    last_d = None
    out: list[dict] = []
    # Newest first so the de-clutter keeps the most recent labels.
    order = sorted(range(len(hits)), key=lambda k: -int(hits.iloc[k]["index"]))
    for k in order:
        h = hits.iloc[k]
        i = int(h["index"])
        if i < n - window or i < 0 or i >= n:
            continue
        if not bool(h["confirmed"]):
            continue
        # newest-first iteration, so the gap is last_d (newer) - dates[i] (older)
        if last_d is not None and (last_d - dates[i]).days < min_gap_days:
            continue
        # Same pattern name repeating within 30 days reads as noise; keep the
        # most recent of each kind instead of stacking identical labels.
        if any(o["name"] == str(h["pattern"])
               and (last_d - dates[i]).days < 30 for o in out):
            continue
        last_d = dates[i]
        out.append({
            "name": str(h["pattern"]),
            "bias": str(h["bias"]),
            "date": dates[i].date().isoformat(),
            "low": float(df["low"].iloc[i]),
            "high": float(df["high"].iloc[i]),
            "i": i,
        })
        if len(out) >= max_n:
            break
    return out


def run(ticker: str, out_path: str, days: int = 200, source: str = "auto", asof: str | None = None) -> dict:
    """Run the full pipeline. Returns the JSON snapshot.

    asof: trim data to T-1 (yesterday's close) by default, or pass YYYY-MM-DD.
    """
    print(f"  fetching {ticker}...", file=sys.stderr)
    df, source, stock_name = fetch_ohlc(ticker, days=days, source=source, asof=asof)
    # 2026-10-14: yfinance returns an EMPTY name for some instruments — 02800.HK
    # (盈富基金) did so on its first day in the turnover universe, and the HK hub
    # published a table row with a blank Name cell. A blank is not a name: it is
    # indistinguishable from "we lost it", and self_test rightly refused to ship
    # it. Fall back to the symbol the user asked for, which is always present and
    # always correct, rather than dropping the row — the bar data was fine.
    stock_name = (stock_name or "").strip() or ticker
    # NaN-row guard (2026-08-26): some HK ETPs/small caps return rows with NaN
    # OHLCV from yfinance/futu → downstream int()/float() conversions crash
    # ("cannot convert float NaN to integer") and the whole snapshot is lost.
    # Drop broken rows up front; keep only bars with real OHLC.
    _ohlc_cols = [c for c in ("open", "high", "low", "close") if c in df.columns]
    df = df.dropna(subset=_ohlc_cols).reset_index(drop=True)
    if len(df) < 20:
        raise RuntimeError(f"only got {len(df)} rows for {ticker}")
    print(f"  got {len(df)} bars from {source} ({stock_name})", file=sys.stderr)

    # Phase
    phase_info = detect_phase(df)
    print(f"  phase: {phase_info['phase']}", file=sys.stderr)

    current = float(df.iloc[-1]["close"])
    prev_close = float(df.iloc[-1].get("last_close", df.iloc[-2]["close"]))
    chg_pct = (current - prev_close) / prev_close * 100

    last_bar = {
        "date": str(df.iloc[-1]["date"].date()),
        "O": round(float(df.iloc[-1]["open"]), 2),
        "H": round(float(df.iloc[-1]["high"]), 2),
        "L": round(float(df.iloc[-1]["low"]), 2),
        "C": round(current, 2),
        "prev_close": round(prev_close, 2),
        "chg_pct": round(chg_pct, 2),
    }

    # S/R ladders
    supports = build_support_ladder(
        df, current,
        phase_info["peak"]["price"], phase_info["trough"]["price"], phase_info["trough"]["date"],
    )
    resistances = build_resistance_ladder(
        df, current,
        phase_info["peak"]["price"], phase_info["peak"]["date"],
        phase_info["trough"]["price"], phase_info["trough"]["date"],
        phase_info["box_top"]["price"], phase_info["box_top"]["date"],
    )
    print(f"  supports: {[s['level'] for s in supports]}", file=sys.stderr)
    print(f"  resistances: {[r['level'] for r in resistances]}", file=sys.stderr)

    position = analyze_position(df, current, supports, resistances)
    kline = analyze_kline_behavior(df, supports, resistances)
    bias = synthesize_bias(phase_info["phase"], kline, position)
    scenarios = build_scenarios(supports, resistances, current)
    action_plan = compute_action_plan(df, phase_info["phase"], current)

    snapshot = {
        "ticker": normalize_ticker(ticker)[0],
        "ticker_user": ticker,
        "name": stock_name,
        "data_source": source,
        "data_range": f"{df.iloc[0]['date'].date()} → {df.iloc[-1]['date'].date()} ({len(df)} daily bars)",
        "last_bar": last_bar,
        "phase": phase_info["phase"],
        # 2026-09-22: surface ADX regime so downstream rendering can show it
        "adx": phase_info.get("adx"),
        "plus_di": phase_info.get("plus_di"),
        "minus_di": phase_info.get("minus_di"),
        "regime": phase_info.get("regime"),
        "adx_threshold_note": phase_info.get("adx_threshold_note"),
        "phase_evidence": f"Peak {phase_info['peak']['price']} ({phase_info['peak']['date']}), trough {phase_info['trough']['price']} ({phase_info['trough']['date']}), box top {phase_info['box_top']['price']} ({phase_info['box_top']['date']})",
        "peak": phase_info["peak"],
        "trough": phase_info["trough"],
        "box": {
            "top": phase_info["box_top"]["price"],
            "top_date": phase_info["box_top"]["date"],
            "bottom": phase_info["trough"]["price"],
            "period": f"{phase_info['trough']['date']} to {df.iloc[-1]['date'].date()}",
        },
        "drop_from_peak_pct": phase_info["drop_from_peak_pct"],
        "recovery_from_crash_pct": phase_info["recovery_from_crash_pct"],
        "supports": supports,
        "resistances": resistances,
        "position": position,
        "kline_today": kline,
        "bias": bias,
        "scenarios": scenarios,
        "common_misjudgments": COMMON_MISJUDGMENTS,
        "action_plan": action_plan,
        # Candlestick patterns, precomputed here so the interactive
        # canvas chart can draw them. The PNG is only a <noscript> fallback
        # (and is no longer shipped), so anything rendered only into the PNG
        # never reaches a visitor. Patterns are annotation, never a signal:
        # they do not touch action_plan / verdict.
        "patterns": _compute_patterns(df),
    }

    # Render with stock name
    render_chart(df, snapshot, ticker, stock_name, out_path)
    print(f"  chart → {out_path}", file=sys.stderr)

    return snapshot


