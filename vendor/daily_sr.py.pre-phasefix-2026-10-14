def _deoverlap_right_labels(ax, fig, entries):
    """Spread right-margin label y positions so text labels never collide.

    entries: list of dicts {y, text, color, fontsize, fontweight}. The horizontal
    S/R lines stay at their TRUE price levels; only the text labels get nudged
    (colour keeps the association clear). Returns [(entry, adjusted_y)] sorted
    top-down. Uses iterative pairwise relaxation inside [lo, hi].
    """
    if not entries:
        return []
    ymin, ymax = ax.get_ylim()
    span = max(ymax - ymin, 1e-9)
    ax_h_in = max(ax.get_position().height * fig.get_figheight(), 1e-6)
    fs_max = max(e["fontsize"] for e in entries)
    lab_h = (fs_max / 72.0) * 1.35 / ax_h_in * span  # label height expressed in data units
    gap = lab_h * 1.10
    # Keep right-margin labels well ABOVE the x-axis month-label band.
    # 2.0× label height from ymin reserves a clear band for "Aug 2026" type
    # month labels without overlapping S/R level text.
    lo, hi = ymin + lab_h * 2.0, ymax - lab_h * 0.30

    order = sorted(range(len(entries)), key=lambda i: entries[i]["y"], reverse=True)
    ys = [float(entries[i]["y"]) for i in order]
    n = len(ys)
    for _ in range(200):
        moved = False
        for i in range(n - 1):
            d = ys[i] - ys[i + 1]
            if d < gap - 1e-9:
                p = (gap - d) / 2.0
                ys[i] += p
                ys[i + 1] -= p
                moved = True
        for i in range(n):
            if ys[i] > hi:
                ys[i] = hi
                moved = True
            elif ys[i] < lo:
                ys[i] = lo
                moved = True
        if not moved:
            break
    return [(entries[order[k]], ys[k]) for k in range(n)]


def render_chart(df: pd.DataFrame, snapshot: dict, ticker: str, name: str, out_path: str):
    """Render the dark-theme candlestick + S/R chart."""
    import matplotlib
    matplotlib.use("Agg")  # 2026-09-22: headless backend so render works in worker threads
    import matplotlib.pyplot as plt
    from matplotlib.patches import Rectangle
    from matplotlib.lines import Line2D
    import matplotlib.dates as mdates

    s = CHART_STYLE
    plt.rcParams.update({
        "font.family": resolve_font_family(),
        "axes.edgecolor": s["grid"],
        "axes.labelcolor": s["text"],
        "xtick.color": s["text_dim"],
        "ytick.color": s["text_dim"],
        "text.color": s["text"],
    })

    fig = plt.figure(figsize=(14, 12), facecolor=s["bg"])
    # 3-row layout: title / chart / footer. Footer needs enough vertical room
    # for the legend swatches + source line WITHOUT colliding with the chart's
    # x-axis month labels. Chart's xaxis lives in gs[1] but the visible month
    # labels render near gs[1]'s bottom edge — which used to clash with
    # right-margin S/R text labels (R3 bottom ~8.0 etc.) that got pushed down
    # by the de-overlapper. Increase footer height and reserve explicit
    # bottom margin so month labels and S/R labels have separate vertical
    # bands.
    # 2026-10-12: volume panel added as a 3rd band (title / price / volume /
    # footer). Month labels moved to the BOTTOM axis (ax_vol) because leaving
    # them on the price axis would strand them in the middle of the figure.
    gs = fig.add_gridspec(4, 1, height_ratios=[0.9, 10.6, 2.0, 0.8], hspace=0.10)
    fig.subplots_adjust(bottom=0.07)

    # --- Title block ---
    ax_title = fig.add_subplot(gs[0])
    ax_title.set_facecolor(s["title_bg"])
    ax_title.set_xticks([]); ax_title.set_yticks([])
    for spine in ax_title.spines.values():
        spine.set_color(s["grid"])

    last = snapshot["last_bar"]
    chg_color = s["down"] if last["chg_pct"] < 0 else s["up"]
    ticker_code = snapshot["ticker"].split(".")[-1] if "." in snapshot["ticker"] else snapshot["ticker"]
    ticker_prefix = snapshot["ticker"].split(".")[0] if "." in snapshot["ticker"] else ""
    display_name = name if name else ticker_code
    title_text = f"{ticker_code}  {display_name}" if not ticker_prefix else f"{ticker_prefix}.{ticker_code}  {display_name}"
    price_text = f"{last['C']}"
    chg_text = f"{last['chg_pct']:+.2f}%  ({last['C'] - last['prev_close']:+.2f})"

    t_title = ax_title.text(0.02, 0.65, title_text, fontsize=20, fontweight="bold", color=s["text"],
                            transform=ax_title.transAxes, va="center")
    ax_title.text(0.02, 0.18,
                  f"Daily K  |  {snapshot['data_range']}  |  Peak {snapshot['peak']['date']} = {snapshot['peak']['price']}  |  Not advice",
                  fontsize=10, color=s["text_dim"], transform=ax_title.transAxes, va="center")
    # Price pinned to the far right edge; chg% measured and placed just left of it;
    # long ticker names auto-shrink instead of colliding with the price.
    t_price = ax_title.text(0.985, 0.50, price_text, fontsize=26, fontweight="bold", color=chg_color,
                            transform=ax_title.transAxes, va="center", ha="right")
    fig.canvas.draw()
    _renderer = fig.canvas.get_renderer()
    _inv = ax_title.transAxes.inverted()
    _bb_p = t_price.get_window_extent(_renderer)
    _px0 = _inv.transform((_bb_p.x0, 0))[0]
    _x_chg = max(_px0 - 0.010, 0.40)
    ax_title.text(_x_chg, 0.50, chg_text, fontsize=13, color=chg_color,
                  transform=ax_title.transAxes, va="center", ha="right")
    _bb_t = t_title.get_window_extent(_renderer)
    _avail_px = (ax_title.transAxes.transform((_x_chg - 0.015, 0))[0]
                 - ax_title.transAxes.transform((0.02, 0))[0])
    if _avail_px > 0 and _bb_t.width > _avail_px:
        t_title.set_fontsize(max(11, int(t_title.get_fontsize() * _avail_px / _bb_t.width)))

    # --- Main chart ---
    ax = fig.add_subplot(gs[1])
    ax.set_facecolor(s["bg"])
    for spine in ax.spines.values():
        spine.set_color(s["grid"])

    dates = df["date"].values
    opens = df["open"].values
    highs = df["high"].values
    lows = df["low"].values
    closes = df["close"].values

    # Candlesticks
    width = 0.7
    for i in range(len(df)):
        is_up = closes[i] >= opens[i]
        color = s["up"] if is_up else s["down"]
        # Wick
        ax.plot([dates[i], dates[i]], [lows[i], highs[i]], color=color, linewidth=0.8, zorder=2)
        # Body
        body_low = min(opens[i], closes[i])
        body_height = abs(closes[i] - opens[i])
        if body_height < 0.001:
            body_height = (highs[i] - lows[i]) * 0.01
        rect = Rectangle(
            (mdates.date2num(dates[i]) - width / 2, body_low),
            width, body_height,
            facecolor=color, edgecolor=color, linewidth=0.5, zorder=3,
        )
        ax.add_patch(rect)

    # --- S/R lines ---
    ymin, ymax = ax.get_ylim()
    ymin = min(ymin, lows.min() * 0.97)
    ymax = max(ymax, highs.max() * 1.02)
    ax.set_ylim(ymin, ymax)

    # Right-margin labels collected here, drawn de-overlapped at the end
    _right_labels = []

    def _add_rlabel(y, text, color, fontsize=10, fontweight="normal"):
        _right_labels.append({"y": float(y), "text": text, "color": color,
                              "fontsize": fontsize, "fontweight": fontweight})

    last_close = last["C"]

    # ------------------------------------------------------------------
    # Chart S/R declutter (2026-08-25):
    # Day-trade charts only need ACTIONABLE levels. Rules:
    #   1. drop levels farther than LEVEL_MAX_DIST_PCT from last close
    #      (e.g. 6869.HK crash low 30.80 when price is 140 → noise)
    #   2. merge levels within LEVEL_MERGE_PCT into one line
    #      (e.g. S1 91.15 vs S2 90.24 — one line, label "S1/S2")
    #   3. cap at nearest LEVEL_KEEP_PER_SIDE per side
    # Full ladders remain in the JSON snapshot + HTML info card.
    # ------------------------------------------------------------------
    LEVEL_MAX_DIST_PCT = 0.60
    LEVEL_MERGE_PCT = 0.02
    LEVEL_KEEP_PER_SIDE = 2

    def _declutter_levels(levels, keep):
        near = [dict(lv) for lv in levels
                if last_close > 0
                and abs(lv["level"] - last_close) / last_close <= LEVEL_MAX_DIST_PCT]
        if not near:
            return []
        merged = []
        for lv in sorted(near, key=lambda x: x["level"]):
            if merged and abs(lv["level"] - merged[-1]["level"]) / last_close <= LEVEL_MERGE_PCT:
                prev = merged[-1]
                tags = list(prev.get("_tags", [prev["label"].split()[0]]))
                new_tag = lv["label"].split()[0]
                if new_tag not in tags:
                    tags.append(new_tag)
                prev["_tags"] = tags
                prev["label"] = "/".join(tags[:3]) + (" KEY" if prev.get("_key") or "KEY" in lv["label"] else "")
                prev["_key"] = bool(prev.get("_key") or "KEY" in lv["label"])
            else:
                lv["_tags"] = [lv["label"].split()[0]]
                lv["_key"] = "KEY" in lv["label"]
                merged.append(lv)
        merged.sort(key=lambda x: abs(x["level"] - last_close))
        kept = merged[:keep]
        kept.sort(key=lambda x: x["level"])
        return kept

    _draw_supports = _declutter_levels(snapshot["supports"], LEVEL_KEEP_PER_SIDE)
    _draw_resistances = _declutter_levels(snapshot["resistances"], LEVEL_KEEP_PER_SIDE)

    # Peak line + marker (hline only when within relevance band; circle always)
    peak = snapshot["peak"]
    peak_dt = pd.to_datetime(peak["date"])
    if last_close > 0 and peak["price"] <= last_close * (1 + LEVEL_MAX_DIST_PCT):
        ax.axhline(y=peak["price"], color=s["peak"], linestyle="--", linewidth=1.0, alpha=0.7, zorder=4)
        _add_rlabel(peak["price"], f" PEAK {peak['price']} ({peak_dt.strftime('%b %d')})", s["peak"], fontsize=9)
    # Peak circle
    if peak_dt in dates:
        peak_idx = list(dates).index(peak_dt)
        ax.plot(dates[peak_idx], peak["price"], "o", color=s["peak"], markersize=10,
                markerfacecolor="none", markeredgewidth=2, zorder=6)
        ax.annotate(f"PEAK {peak['price']}", xy=(dates[peak_idx], peak["price"]),
                    xytext=(dates[peak_idx], peak["price"] + (ymax - ymin) * 0.04),
                    color=s["peak"], fontsize=10, ha="center", fontweight="bold")

    # Trough marker (NO line — the S4 line below serves that role)
    trough = snapshot["trough"]
    trough_dt = pd.to_datetime(trough["date"])
    if trough_dt in dates:
        trough_idx = list(dates).index(trough_dt)
        ax.plot(dates[trough_idx], trough["price"], "o", color=s["trough"], markersize=10,
                markerfacecolor="none", markeredgewidth=2, zorder=6)
        ax.annotate(f"{trough_dt.strftime('%b %d')} low {trough['price']}",
                    xy=(dates[trough_idx], trough["price"]),
                    xytext=(dates[trough_idx], trough["price"] - (ymax - ymin) * 0.05),
                    color=s["trough"], fontsize=9, ha="center", fontweight="bold")

    # Support lines (decluttered — nearest 2, merged clusters, in-band only)
    for s_lvl in _draw_supports:
        is_key = s_lvl.get("_key", "KEY" in s_lvl["label"])
        color = s["support_key"] if is_key else s["support"]
        ls = "-" if is_key else "--"
        lw = 1.8 if is_key else 1.0
        ax.axhline(y=s_lvl["level"], color=color, linestyle=ls, linewidth=lw, alpha=0.7, zorder=4)
        _add_rlabel(s_lvl["level"], f" {s_lvl['label']} ~{s_lvl['level']}", color,
                    fontweight="bold" if is_key else "normal")

    # Resistance lines (decluttered — nearest 2)
    for r_lvl in _draw_resistances:
        ax.axhline(y=r_lvl["level"], color=s["resistance"], linestyle="--",
                   linewidth=1.0, alpha=0.7, zorder=4)
        _add_rlabel(r_lvl["level"], f" {r_lvl['label']} ~{r_lvl['level']}", s["resistance"])

    # Current price line + label (de-overlapped together with all other labels)
    ax.axhline(y=last_close, color=s["current"], linestyle=":", linewidth=1.2, alpha=0.9, zorder=4)
    _add_rlabel(last_close, f" ◯Last {last_close}", s["current"], fontweight="bold")

    # --- Candlestick pattern annotations (REFERENCE ONLY) -------------------
    # Deliberately NOT wired into anything decision-related: not the JSON
    # snapshot, not action_plan, not the verdict. It is a visual annotation so
    # the reader can see what pattern printed on which bar.
    #
    # Display rules, chosen to keep it reference material rather than a second
    # signal (measured edge of TA filters over this signal set was +0.44pp with
    # t<1, i.e. indistinguishable from zero):
    #   - confirmed patterns only (unconfirmed ones are still forming)
    #   - last PATTERN_WINDOW bars only (a full 200-bar chart shows ~56 hits,
    #     which is noise, not information)
    #   - neutral grey, no bullish/bearish wording and no directional glyph, so
    #     the marker cannot read as a recommendation
    #   - tiny label under the candle's low, outside the S/R label band
    PATTERN_WINDOW = 90
    try:
        import candle_patterns as _cp
        _pframe = df.rename(columns={"date": "time"})[["open", "high", "low", "close", "time"]]
        _hits = _cp.detect(_pframe)
        _hits = _hits[_hits["confirmed"]]
        _idx_of_date = {pd.Timestamp(d): i for i, d in enumerate(dates)}
        # Stagger label heights so nearby patterns don't overprint each other.
        _LANES = 2
        _MIN_GAP_DAYS = 12      # one label per ~2 weeks keeps the chart readable
        _MAX_LABELS = 10
        _lane_last = [None] * _LANES
        _shown = []
        for _, _h in _hits.iterrows():
            _i = int(_h["index"])
            if _i < len(dates) - PATTERN_WINDOW:
                continue
            _x = pd.Timestamp(_h["date"])
            if _x not in _idx_of_date:
                continue
            _di = _idx_of_date[_x]
            _gap = (ymax - ymin)
            # Right-edge zone: the S/R right-margin labels (R1 today high,
            # S1 bottom, Last ...) live at the far right of the price band, so a
            # pattern label sitting just under a candle there lands on top of
            # them. Push those labels well clear instead of dropping them —
            # the most recent pattern is the one worth reading.
            _near_right = _di >= len(dates) - 20
            _base_off = 0.062 if _near_right else 0.020
            _step = 0.024 if _near_right else 0.020
            # pick the first lane that is clear both vertically and horizontally
            _lane = None
            for _l in range(_LANES):
                _y_try = float(lows[_di]) - _gap * (_base_off + _step * _l)
                _prev_x = _lane_last[_l]
                if _prev_x is None or (_x - _prev_x).days >= _MIN_GAP_DAYS:
                    _lane, _y_use = _l, _y_try
                    break
            if _lane is None or len(_shown) >= _MAX_LABELS:
                continue   # too dense — skip rather than clutter
            _lane_last[_lane] = _x
            ax.plot(dates[_di], float(lows[_di]), "v", color=s["text_dim"],
                    markersize=4.5, zorder=3, alpha=0.95)
            ax.annotate(_h["pattern"], xy=(dates[_di], float(lows[_di])),
                        xytext=(dates[_di], _y_use), color=s["text"],
                        fontsize=8, ha="center", va="top", zorder=6,
                        alpha=0.85,
                        bbox=dict(boxstyle="round,pad=0.15", facecolor=s["bg"],
                                  edgecolor="none", alpha=0.55))
            _shown.append(_h["pattern"])
    except Exception:
        _shown = []          # never let an annotation bug break the chart

    # Draw every right-margin label at a collision-free y position
    _x_lab = mdates.date2num(dates[-1]) + 1
    for _e, _y in _deoverlap_right_labels(ax, fig, _right_labels):
        ax.text(_x_lab, _y, _e["text"], color=_e["color"], fontsize=_e["fontsize"],
                va="center", ha="left", fontweight=_e["fontweight"], zorder=5, clip_on=False)

    # Grid
    ax.grid(True, color=s["grid"], linestyle="-", linewidth=0.5, alpha=0.5)
    ax.set_axisbelow(True)

    # Y-axis with price labels
    ax.yaxis.set_major_formatter(plt.FuncFormatter(lambda x, _: f"{x:.0f}"))

    # Right margin for labels — keep tight so the rightmost S/R labels
    # (R3 today high, R3 bottom etc.) and the August month label don't overlap.
    ax.set_xlim(mdates.date2num(dates[0]) - 2, mdates.date2num(dates[-1]) + 2)

    # --- MA overlay on the price panel (2026-10-12) -------------------------
    # Context, never a signal: MA lines do not enter the action plan.
    # MA20 = the "is price stretched from its recent norm" line, which is the
    # quantity his S/R mean-reversion logic actually cares about; MA60 =
    # the slower regime line.
    try:
        _close_s = pd.Series(closes, dtype="float64")
        _ma20 = _close_s.rolling(20, min_periods=20).mean()
        _ma60 = _close_s.rolling(60, min_periods=60).mean()
        _xn = mdates.date2num(dates)
        if _ma60.notna().any():
            ax.plot(_xn, _ma60.values, color=s["text_dim"], linewidth=1.2,
                    alpha=0.9, zorder=2.5, label="MA60")
        if _ma20.notna().any():
            ax.plot(_xn, _ma20.values, color=s["text"], linewidth=1.1,
                    alpha=0.85, zorder=2.5, label="MA20")
    except Exception:
        pass

    # --- Volume panel (2026-10-12) ---
    # Shares the price axis's x so bars line up with the candles exactly.
    # Volume is context, not a signal: it is drawn, never used by the action
    # plan. Same rule as the candlestick-pattern annotations.
    ax_vol = fig.add_subplot(gs[2], sharex=ax)
    ax_vol.set_facecolor(s["bg"])
    for spine in ax_vol.spines.values():
        spine.set_color(s["grid"])
    ax.tick_params(axis="x", labelbottom=False)      # labels move to ax_vol

    if "volume" in df.columns and df["volume"].notna().any():
        vols = df["volume"].values.astype(float)
        v_up = closes >= opens
        bar_w = width * 0.9
        ax_vol.bar(mdates.date2num(dates)[v_up], vols[v_up], width=bar_w,
                   color=s["up"], alpha=0.75, linewidth=0, zorder=2)
        ax_vol.bar(mdates.date2num(dates)[~v_up], vols[~v_up], width=bar_w,
                   color=s["down"], alpha=0.75, linewidth=0, zorder=2)
        # 20-session average volume — the "is this breakout backed by volume" line
        if len(vols) >= 20:
            _vma = pd.Series(vols).rolling(20).mean()
            ax_vol.plot(mdates.date2num(dates), _vma.values, color=s["text_dim"],
                        linewidth=1.1, alpha=0.9, zorder=3)
        ax_vol.set_ylim(0, float(np.nanmax(vols)) * 1.18)
    else:
        ax_vol.text(0.5, 0.5, "no volume data", transform=ax_vol.transAxes,
                    ha="center", va="center", color=s["text_dim"], fontsize=9)
    ax_vol.set_ylabel("Vol", color=s["text_dim"], fontsize=8)
    ax_vol.tick_params(axis="y", labelsize=7, colors=s["text_dim"])
    # Turn 1.4e8 into "140M" — scientific notation is unreadable at this size.
    def _vol_fmt(x, _):
        if x >= 1e9:
            return f"{x/1e9:.1f}B"
        if x >= 1e6:
            return f"{x/1e6:.0f}M"
        if x >= 1e3:
            return f"{x/1e3:.0f}K"
        return f"{x:.0f}"
    ax_vol.yaxis.set_major_formatter(plt.FuncFormatter(_vol_fmt))
    ax_vol.grid(True, alpha=0.25, color=s["grid"])
    ax_vol.set_axisbelow(True)
    # Date axis — month labels live on the BOTTOM band (the volume panel), so
    # they sit at the foot of the figure instead of stranded mid-chart.
    # Month labels live on the bottom-most DATA panel (ax_vol).
    ax_vol.xaxis.set_major_locator(mdates.MonthLocator())
    ax_vol.xaxis.set_major_formatter(mdates.DateFormatter("%b"))
    ax_vol.tick_params(axis="x", labelsize=10)

    # --- Footer ---
    ax_foot = fig.add_subplot(gs[3])
    ax_foot.set_facecolor(s["title_bg"])
    ax_foot.set_xticks([]); ax_foot.set_yticks([])
    for spine in ax_foot.spines.values():
        spine.set_color(s["grid"])

    # Legend with colored swatches in a single horizontal row
    legend_items = [
        ("Support", s["support"], "--"),
        ("Key S1", s["support_key"], "-"),
        ("Resistance", s["resistance"], "--"),
        ("MA20", s["text"], "-"),
        ("MA60", s["text_dim"], "-"),
        ("Peak", s["peak"], "--"),
        ("Current", s["current"], ":"),
    ]
    # Render each item: [swatch] Label
    x_cursor = 0.02
    for label, color, _ in legend_items:
        # Swatch
        ax_foot.add_patch(Rectangle((x_cursor, 0.55), 0.018, 0.30,
                                     facecolor=color, edgecolor="none",
                                     transform=ax_foot.transAxes))
        x_cursor += 0.022
        # Label
        ax_foot.text(x_cursor, 0.70, label, fontsize=10, color=s["text"],
                     transform=ax_foot.transAxes, va="center", ha="left")
        x_cursor += 0.012 * len(label) + 0.025  # advance

    # OHLV + source line
    _vol = df.iloc[-1]["volume"]
    volume_str = f"{int(_vol):,}" if _vol == _vol and _vol is not None else "n/a"
    ohlv = f"O{last['O']}  H{last['H']}  L{last['L']}  C{last['C']}  V{volume_str}"
    ax_foot.text(0.02, 0.20,
                 f"Source: {snapshot['data_source']} {snapshot['ticker']} ({display_name})  |  {ohlv}  |  Education only — not investment advice",
                 fontsize=9, color=s["text_dim"], transform=ax_foot.transAxes, va="center")

    plt.savefig(out_path, dpi=130, facecolor=s["bg"], bbox_inches="tight")
    plt.close(fig)


