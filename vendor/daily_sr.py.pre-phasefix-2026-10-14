# Phase → strategy compatibility (used for phase_match flag)
_PHASE_MATCH = {
    "SELL_R1": {"downtrend_active", "base_building", "range"},
    "BUY_S1": {"downtrend_recovery", "uptrend", "base_building", "range"},
    "BREAK_LONG": {"uptrend"},
    "BREAK_SHORT": {"downtrend_active"},
    "WAIT_RANGE": {"base_building", "range"},
}


def _action_plan_notes(strategy, s1, r1, mid, current, pos_pct, trigger, target, stop,
                       atr_pct: float = 0.0, box_width_pct: float = 0.0):
    """Format the one-line notes string for the action plan."""
    if strategy == "WAIT_VOLATILE":
        return (f"WAIT_VOLATILE: ATR14 {atr_pct:.1f}% / box width {box_width_pct:.0f}% — "
                f"波動太大（thresholds: ATR≥{VOL_GUARD_ATR_PCT:.0f}% 或 box≥{VOL_GUARD_BOX_PCT:.0f}%），"
                f"range mean-reversion 暫停，等波動收窄先再睇。")
    if strategy == "WAIT_RR_TOO_THIN":
        return "WAIT_RR_TOO_THIN: stop 已加闊到 1.5×ATR 但 R:R 唔夠 — 等更好嘅位置先入場。"
    if strategy == "SELL_R1":
        return (f"SELL_R1: in box ({s1:.0f}-{r1:.0f}), entry at R1 {trigger:.0f}, "
                f"target mid {target:.0f}, stop {stop:.0f}")
    if strategy == "BUY_S1":
        return (f"BUY_S1: in box ({s1:.0f}-{r1:.0f}), entry at S1 {trigger:.0f}, "
                f"target mid {target:.0f}, stop {stop:.0f}")
    if strategy == "BREAK_LONG":
        return (f"BREAK_LONG: close {current:.0f} above R1 {r1:.0f}, "
                f"target R2 {target:.0f}, stop {stop:.0f}")
    if strategy == "BREAK_SHORT":
        return (f"BREAK_SHORT: close {current:.0f} below S1 {s1:.0f}, "
                f"target S2 {target:.0f}, stop {stop:.0f}")
    # WAIT_RANGE
    return f"WAIT_RANGE: in box ({s1:.0f}-{r1:.0f}), pos {pos_pct:.0f}%, no clear setup"


def compute_action_plan(df: pd.DataFrame, phase: str, current: float) -> dict:
    """Deterministic action plan from OHLC + phase.

    Pure function: takes DataFrame, phase string, current close.
    Returns dict matching the action_plan JSON schema.

    Decision rules (no LLM):
      1. Compute s1/r1/s2/r2/s3/r3/s4/mid from rolling windows.
      2. Breakout rules (priority): close > r1*1.005 → BREAK_LONG, close < s1*0.995 → BREAK_SHORT.
      3. Phase + position rules: SELL_R1 in downtrend_active (pos>=70),
         BUY_S1 in downtrend_recovery/uptrend (pos<=30), WAIT in base_building/range.
      4. Strategy → trigger/target/stop mapping.
      5. risk_pct, reward_pct, rr_ratio.
      6. phase_match against _PHASE_MATCH table.
    """
    n = len(df)

    # --- Insufficient data guard (need >= 20 bars for s1/r1) ---
    if n < 20 or not np.isfinite(current):
        return {
            "verdict": "WAIT",
            "strategy": "WAIT_RANGE",
            "trigger_price": None,
            "target_price": None,
            "stop_price": None,
            "risk_pct": 0.0,
            "reward_pct": 0.0,
            "rr_ratio": 0.0,
            "phase_match": False,
            "r1": None, "s1": None,
            "s2": None, "r2": None,
            "r3": None, "s3": None, "s4": None,
            "current_position_pct": 50.0,
            "notes": f"WAIT_RANGE: insufficient data (n={n}, need >=20 bars)",
        }

    # --- 1. Pivot levels (rolling windows, no overlap) ---
    s1 = float(df["low"].iloc[-20:].min())
    r1 = float(df["high"].iloc[-20:].max())
    mid = (s1 + r1) / 2.0

    # s2, r2: last 60 days excluding last 20
    if n >= 60:
        s2 = float(df["low"].iloc[-60:-20].min())
        r2 = float(df["high"].iloc[-60:-20].max())
    elif n > 20:
        s2 = float(df["low"].iloc[:-20].min())
        r2 = float(df["high"].iloc[:-20].max())
    else:  # 20 <= n < 40 — partial window, fall back
        s2, r2 = s1, r1

    # s3, r3: last 120 days excluding last 60
    if n >= 120:
        s3 = float(df["low"].iloc[-120:-60].min())
        r3 = float(df["high"].iloc[-120:-60].max())
    elif n > 60:
        s3 = float(df["low"].iloc[:-60].min())
        r3 = float(df["high"].iloc[:-60].max())
    else:
        s3, r3 = s2, r2

    # s4: all data excluding last 120 (cap at 200 since we fetch 200 by default)
    if n > 120:
        s4 = float(df["low"].iloc[:-120].min())
    else:
        s4 = s3

    # --- current_position_pct (clamped to [0, 100]) ---
    if r1 > s1:
        pos_pct = (current - s1) / (r1 - s1) * 100.0
    else:
        # Degenerate: zero-width box (no trades within window) — center it.
        pos_pct = 50.0
    pos_pct = max(0.0, min(100.0, pos_pct))

    # --- Volatility metrics (ATR14 % of price; 20d box width % of price) ---
    _h, _l, _c = df["high"], df["low"], df["close"]
    _prev_c = _c.shift(1)
    _tr = pd.concat([_h - _l, (_h - _prev_c).abs(), (_l - _prev_c).abs()], axis=1).max(axis=1)
    atr14 = float(_tr.rolling(14).mean().iloc[-1]) if n >= 15 else float(_tr.mean())
    atr_pct = (atr14 / current * 100.0) if current > 0 else 0.0
    box_width_pct = ((r1 - s1) / current * 100.0) if current > 0 else 0.0

    # --- 2 & 3. Determine verdict (breakouts first, then phase rules) ---
    verdict: Optional[str] = None
    strategy: Optional[str] = None

    if current > r1 * 1.005:
        verdict, strategy = "BUY", "BREAK_LONG"
    elif current < s1 * 0.995:
        verdict, strategy = "SELL", "BREAK_SHORT"
    elif phase == "uptrend":
        if current > mid and pos_pct >= 70:
            verdict, strategy = "WAIT", "WAIT_RANGE"
        elif pos_pct <= 30:
            verdict, strategy = "BUY", "BUY_S1"
    elif phase == "downtrend_active":
        if pos_pct >= 60:
            verdict, strategy = "SELL", "SELL_R1"
    elif phase == "downtrend_recovery":
        if pos_pct <= 30:
            verdict, strategy = "BUY", "BUY_S1"
    elif phase == "base_building":
        # 寬鬆 base_building 規則：上 60% 可 SELL, 下 30% 可 BUY
        if pos_pct >= 60:
            verdict, strategy = "SELL", "SELL_R1"
        elif pos_pct <= 30:
            verdict, strategy = "BUY", "BUY_S1"
    elif phase == "range":
        if pos_pct >= 70:
            verdict, strategy = "SELL", "SELL_R1"
        elif pos_pct <= 30:
            verdict, strategy = "BUY", "BUY_S1"

    # Default fallback — no rule fired (e.g., downtrend + mid box).
    if verdict is None:
        verdict, strategy = "WAIT", "WAIT_RANGE"

    # --- 3b. Volatility guard (2026-08-25) ---
    # Inside-box mean reversion (SELL_R1 / BUY_S1) is statistically unsafe when
    # daily noise dwarfs the stop or the "box" is too wide to be a range.
    if strategy in ("SELL_R1", "BUY_S1") and (
        atr_pct >= VOL_GUARD_ATR_PCT or box_width_pct >= VOL_GUARD_BOX_PCT
    ):
        verdict, strategy = "WAIT", "WAIT_VOLATILE"

    # --- 3c. Regime guard (2026-09-22, annotated 2026-09-28) ---
    # Route strategies by ADX(14) regime:
    #   - regime='range' (ADX<20): mean reversion only (SELL_R1/BUY_S1). Demote
    #     breakouts to WAIT_RANGE — they statistically fail in ranges because
    #     R:R becomes negative.
    #   - regime='trend' (ADX>25): breakouts only (BREAK_LONG/BREAK_SHORT).
    #     Demote mean reversion to WAIT — box-edge fades hit often.
    #   - regime='dead' (20<=ADX<=25): no override (let phase routing decide).
    #
    # DO NOT veto the dead zone. Measured 2026-09-28 on this site's own signals
    # (HK, 20 signal days, 1066 signals, 5-session forward, 0.25% costs):
    #     regime=dead   n=219  win 71.7%  mean +2.7059%  PF 4.48   <-- BEST
    #     regime=range  n=847  win 66.7%  mean +1.9328%  PF 2.92
    # The dead zone is the best-performing regime for a MEAN-REVERSION strategy
    # (weak trend = a range forming a trend, which is where box-edge fades work).
    # It is only poisonous for TREND-FOLLOWING breakouts, which this site does
    # not rely on. An earlier note here claimed 88.9% from "StratProof/RSI+ADX
    # backtests" — that is same-bar indicator accuracy, not a trade result.
    # The honest forward number for this logic is 67.7% win / +2.09% per trade.
    _regime = _regime_fields(df)
    _regime_label = _regime.get("regime", "n/a")
    if _regime_label == "range" and strategy in ("BREAK_LONG", "BREAK_SHORT"):
        verdict, strategy = "WAIT", "WAIT_REGIME"
    elif _regime_label == "trend" and strategy in ("SELL_R1", "BUY_S1"):
        verdict, strategy = "WAIT", "WAIT_REGIME"

    # --- 3d. Volume confirmation gate (2026-09-22) ---
    # Trigger-day volume > 1.5× 20-day average → confirm participation.
    # If today's volume is below threshold, demote to WAIT — empirical lift
    # in win rate from volume-confirmed breakouts is documented.
    VOL_MULT = 1.5  # 50% above 20-day average
    VOL_WINDOW = 20
    if "volume" in df.columns and len(df) >= VOL_WINDOW + 1:
        _vol_today = float(df["volume"].iloc[-1])
        _vol_avg = float(df["volume"].iloc[-(VOL_WINDOW + 1):-1].mean())
        if _vol_avg > 0 and _vol_today < VOL_MULT * _vol_avg:
            # Low-volume day: most price action is noise. Demote actionable
            # signals (breakouts especially) to WAIT.
            if strategy in ("BREAK_LONG", "BREAK_SHORT"):
                verdict, strategy = "WAIT", "WAIT_LOW_VOL"

    # NOTE: a second, verbatim copy of the regime guard used to sit here.
    # It was idempotent (the second pass saw strategy already rewritten to
    # WAIT_REGIME and changed nothing) but it recomputed _regime_fields on
    # every call for all 200 tickers x 3 markets. Removed 2026-09-28.

    # --- 4. Trigger / target / stop per strategy ---
    if strategy == "SELL_R1":
        # Stop distance: never tighter than 2%, and never inside 1.5×ATR noise.
        _stop_dist = max(0.02, STOP_ATR_MULT * atr_pct / 100.0)
        trigger, target, stop = r1, mid, r1 * (1 + _stop_dist)
    elif strategy == "BUY_S1":
        _stop_dist = max(0.02, STOP_ATR_MULT * atr_pct / 100.0)
        trigger, target, stop = s1, mid, s1 * (1 - _stop_dist)
    elif strategy == "BREAK_LONG":
        trigger, target, stop = current, r2, r1 * 0.99
    elif strategy == "BREAK_SHORT":
        trigger, target, stop = current, s2, s1 * 1.01
    else:  # WAIT_RANGE / WAIT_VOLATILE
        trigger, target, stop = None, None, None

    # --- 5. Risk / reward / R:R ---
    if trigger is not None and trigger > 0:
        risk_pct = abs(stop - trigger) / trigger * 100.0
        reward_pct = abs(target - trigger) / trigger * 100.0
        rr_ratio = reward_pct / risk_pct if risk_pct > 0 else 0.0
    else:
        risk_pct = reward_pct = rr_ratio = 0.0

    # --- 5b. Direction sanity check (v2.2) ---
    # A BUY plan with target<trigger, or SELL plan with target>trigger,
    # means the plan wants the price to move against the trade idea.
    # abs() would mask this as a positive R:R. Demote to WAIT instead.
    # (2026-08-25 fix: notes are plain strings — the old list-of-dicts format
    #  was silently overwritten AND rendered as Python repr in HTML.)
    _extra_notes: list = []
    if verdict in ("BUY", "SELL") and trigger is not None and target is not None:
        wrong_dir = (verdict == "BUY" and target <= trigger) or \
                    (verdict == "SELL" and target >= trigger)
        if wrong_dir:
            verdict, strategy = "WAIT", "WAIT_RANGE"
            trigger, target, stop = None, None, None
            risk_pct = reward_pct = rr_ratio = 0.0
            _extra_notes.append(
                "sanity: 原始訊號 target 同 verdict 方向矛盾（BUY 但目標價較 trigger 低 / "
                "SELL 但目標價較 trigger 高），已自動降級為 WAIT，避免被 abs() 化成假 R:R。"
            )

    # --- 5b-bis. Entry-level integrity note (2026-09-30) ---
    # Found on 02318.HK: the page showed "BUY at S1 52.2" from the Action Plan
    # and "IF 失守 52.20 (S1) THEN SHORT" from the scenarios, with nothing
    # saying which applies. They are the same level described from two sides,
    # and the rule that resolves it is the one the scenarios already imply:
    # a level is only tradeable if price HOLDS it. Touching S1 and closing
    # below is a support failure, not a dip to buy.
    #
    # This is a note, not a gate. The backtest enforces the hold rule at fill
    # time (backtest_site_strategy.py, HOLD_CLOSE); demoting here would need
    # intraday context this function does not have, and guessing would be worse
    # than saying so.
    if verdict in ("BUY", "SELL") and trigger is not None:
        _lv = "support" if verdict == "BUY" else "resistance"
        _extra_notes.append(
            f"52.2 條規則（{verdict} plan，{_lv} {trigger:.2f}）："
            f"① 跌到 {trigger:.2f}、收市守住喺 {trigger:.2f} 上面 → 照 BUY 條 plan 做（入場 {trigger:.2f}，"
            f"止蝕 {(stop or 0):.2f}，目標 {(target or 0):.2f}）。"
            f"② 收市跌穿 {trigger:.2f} → 支持失效，本 BUY 單作廢，唔好接；呢個先係下面『SHORT』情境成立嘅時刻，"
            f"但 SHORT 係另一套 plan，唔係自動開倉。"
            f"③ 一句講晒：唔係睇『有冇觸及』，係睇『收市喺唔喺 {trigger:.2f} 上面』。"
        )

    # --- 5c. R:R floor after ATR-widened stops (2026-08-25) ---
    # Widening the stop to clear 1.5×ATR noise is honest, but if the resulting
    # risk kills the payoff the plan is not worth taking — demote instead of
    # shipping an ugly R:R.
    if verdict in ("BUY", "SELL") and rr_ratio > 0 and rr_ratio < RR_FLOOR:
        verdict, strategy = "WAIT", "WAIT_RR_TOO_THIN"
        trigger, target, stop = None, None, None
        risk_pct = reward_pct = rr_ratio = 0.0
        _extra_notes.append(
            f"rr_floor: stop 加闊到 {STOP_ATR_MULT}×ATR 後 R:R < {RR_FLOOR}，賠率唔夠，降級 WAIT。"
            f"等價格更近 trigger 或者波動收窄先再睇。"
        )

    # --- 6. phase_match ---
    phase_match = phase in _PHASE_MATCH.get(strategy, set())

    base_note = _action_plan_notes(strategy, s1, r1, mid, current, pos_pct,
                                   trigger, target, stop,
                                   atr_pct=atr_pct, box_width_pct=box_width_pct)
    notes = base_note if not _extra_notes else (
        base_note + " ｜ " + " ｜ ".join(_extra_notes)
    )

    return {
        "verdict": verdict,
        "strategy": strategy,
        "trigger_price": round(trigger, 2) if trigger is not None else None,
        "target_price": round(target, 2) if target is not None else None,
        "stop_price": round(stop, 2) if stop is not None else None,
        "risk_pct": round(risk_pct, 2),
        "reward_pct": round(reward_pct, 2),
        "rr_ratio": round(rr_ratio, 2),
        "phase_match": phase_match,
        "r1": round(r1, 2),
        "s1": round(s1, 2),
        "s2": round(s2, 2),
        "r2": round(r2, 2),
        "r3": round(r3, 2),
        "s3": round(s3, 2),
        "s4": round(s4, 2),
        "current_position_pct": round(pos_pct, 1),
        "notes": notes,
    }


