# CLI
# =============================================================================

def main():
    p = argparse.ArgumentParser(description="Daily OHLC + S/R chart for one ticker")
    p.add_argument("-t", "--ticker", required=True, help="Ticker, e.g. 09992.HK, AAPL, 03888")
    p.add_argument("-o", "--out", required=True, help="Output PNG path")
    p.add_argument("--days", type=int, default=200, help="Lookback days (default 200)")
    p.add_argument("--json", help="Also write JSON snapshot to this path")
    p.add_argument("--source", choices=["futu", "yfinance", "auto"], default="auto",
                   help="Data source: futu (OpenD), yfinance (web), or auto (try futu then yfinance)")
    p.add_argument("--asof", help="Use data as of this date YYYY-MM-DD (default: T-1 / yesterday's close)")
    args = p.parse_args()

    try:
        snap = run(args.ticker, args.out, days=args.days, source=args.source, asof=args.asof)
    except Exception as e:
        print(json.dumps({"error": str(e), "ticker": args.ticker}), file=sys.stderr)
        sys.exit(1)

    out_json = json.dumps(snap, ensure_ascii=False, indent=2)
    print(out_json)
    if args.json:
        Path(args.json).write_text(out_json, encoding="utf-8")


if __name__ == "__main__":
    main()
