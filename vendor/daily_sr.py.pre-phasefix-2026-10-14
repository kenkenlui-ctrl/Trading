def detect_phase(df: pd.DataFrame) -> dict:
    """Detect market phase from the OHLC structure.

    Strategy: find the CURRENT cycle's peak (most recent local high followed
    by a significant drawdown), not the absolute all-time high. This matches
    how a human analyst reads a chart.
    """
    high = df["high"]
    low = df["low"]
    close = df["close"]
    current = float(close.iloc[-1])
    n = len(df)

    def _d(d):
        return d.date() if hasattr(d, "date") else d

    # 1) Find the current cycle's peak:
    #    Find the LOCAL HIGH that has the LARGEST forward drawdown (within
    #    90 days). That's typically the cycle's main peak.
    peak_idx = None
    peak_price = None
    best_drop = 0.30  # minimum 30% to qualify
    for i in range(10, n - 10):
        local_window = high.iloc[max(0, i - 5):min(n, i + 6)]
        if high.iloc[i] != local_window.max():
            continue
        forward = low.iloc[i + 1:min(n, i + 91)]
        if len(forward) < 5:
            continue
        min_after = float(forward.min())
        drop = (float(high.iloc[i]) - min_after) / float(high.iloc[i])
        if drop >= best_drop:
            # Prefer higher peaks with sufficient drop (cycle's main peak)
            # Tie-break: more recent
            if peak_idx is None or float(high.iloc[i]) > peak_price:
                peak_idx = i
                peak_price = float(high.iloc[i])
                peak_date = df.iloc[i]["date"]

    if peak_idx is None:
        # Fallback: just use the overall high
        peak_idx = int(high.idxmax())
        peak_price = float(high.iloc[peak_idx])
        peak_date = df.iloc[peak_idx]["date"]

    # 2) Crash low = lowest low AFTER the peak
    post_peak = df.iloc[peak_idx:].reset_index(drop=True)
    if len(post_peak) >= 3:
        crash_pos = int(post_peak["low"].idxmin())
        crash_low = float(post_peak["low"].iloc[crash_pos])
        crash_date = post_peak.iloc[crash_pos]["date"]
    else:
        # Peak is very recent — use the most recent SWING low as the trough
        # (the "low of the current cycle" before the latest push)
        recent_window = df.tail(60).reset_index(drop=True)
        # Find the lowest swing low in the recent window
        swing_lows = find_swing_levels(recent_window["low"], order=5, direction="low")
        if swing_lows:
            # Take the most recent swing low
            crash_pos, crash_low = swing_lows[-1]
            crash_date = recent_window.iloc[crash_pos]["date"]
        else:
            crash_pos = int(recent_window["low"].idxmin())
            crash_low = float(recent_window["low"].iloc[crash_pos])
            crash_date = recent_window.iloc[crash_pos]["date"]

    # 3) Base period = from crash_date to now
    base = df[df["date"] >= crash_date].reset_index(drop=True)
    if len(base) < 5:
        # Peak is too recent to have a meaningful base — extend backwards
        base = df.tail(30).reset_index(drop=True)
        # Don't overwrite crash_low; just use a wider base for box calc
        if crash_low > float(base["low"].min()):
            # Update crash_low to the actual lowest in the extended base
            min_pos = int(base["low"].idxmin())
            crash_low = float(base["low"].iloc[min_pos])
            crash_date = base.iloc[min_pos]["date"]

    base_high = float(base["high"].max())
    base_high_pos = int(base["high"].idxmax())
    base_high_date = base.iloc[base_high_pos]["date"]
    base_low = float(base["low"].min())
    base_low_pos = int(base["low"].idxmin())
    base_low_date = base.iloc[base_low_pos]["date"]

    # 4) Phase heuristics — use POSITION IN RANGE (not just recent vs peak)
    #    Position = where current sits in (trough, peak): 0 = at trough, 1 = at peak
    drop_from_peak = (peak_price - current) / peak_price
    recovery_from_crash = (current - crash_low) / crash_low if crash_low > 0 else 0
    base_range_pct = (base_high - base_low) / base_low if base_low > 0 else 0
    overall_range_pct = (peak_price - crash_low) / crash_low if crash_low > 0 else 0

    if peak_price > crash_low > 0:
        position_in_range = (current - crash_low) / (peak_price - crash_low)
    else:
        position_in_range = 0.5
    position_in_range = max(0.0, min(1.0, position_in_range))

    # Days since trough
    days_since_trough = (df["date"].iloc[-1] - pd.to_datetime(crash_date)).days if hasattr(crash_date, 'date') else 0
    days_since_trough = max(0, days_since_trough)

    # Recent 30-day behavior
    recent30 = df.tail(30)
    recent_high_30 = float(recent30["high"].max())
    recent_low_30 = float(recent30["low"].min())
    # New low in last 30 days?
    made_new_low_30 = recent_low_30 <= crash_low * 1.02

    if position_in_range > 0.85 and recovery_from_crash > 0.05:
        phase = "uptrend"
    elif position_in_range < 0.15 and (made_new_low_30 or days_since_trough < 30):
        phase = "downtrend_active"
    elif 0.15 <= position_in_range <= 0.85 and days_since_trough > 30 and not made_new_low_30:
        phase = "base_building"
    elif made_new_low_30:
        phase = "downtrend_active"
    elif position_in_range < 0.20:
        phase = "downtrend_recovery"  # new low was long ago, but still near bottom
    else:
        phase = "range"

    return {
        "phase": phase,
        "peak": {"date": str(_d(peak_date)), "price": round(peak_price, 2)},
        "trough": {"date": str(_d(crash_date)), "price": round(crash_low, 2)},
        "box_top": {"date": str(_d(base_high_date)), "price": round(base_high, 2)},
        "base_period_low": {"date": str(_d(base_low_date)), "price": round(base_low, 2)},
        "drop_from_peak_pct": round(drop_from_peak * 100, 1),
        "recovery_from_crash_pct": round(recovery_from_crash * 100, 1),
        "base_range_pct": round(base_range_pct * 100, 1),
        "overall_range_pct": round(overall_range_pct * 100, 1),
        # 2026-09-22: regime detection via 14-period ADX (Wilder smoothing).
        # ADX < 20 → range/ranging → favor mean reversion (SELL_R1 / BUY_S1).
        # 20 ≤ ADX ≤ 25 → dead zone → no override (let phase decide).
        # ADX > 25 → trending → prefer breakouts (BREAK_LONG / BREAK_SHORT).
        # Empirical: StratProof/RSI+ADX backtests hit 88.9% win rate with this gate.
        **_regime_fields(df),
    }


def _regime_fields(df: pd.DataFrame) -> dict:
    """Compute ADX(14) + regime classification for the regime filter.

    Returns:
        dict with: adx (round 2), plus_di, minus_di, regime ("range"|"dead"|"trend"),
        adx_threshold_note.

    Why this exists:
        Empirical evidence (StratProof Lab, RobotTraders) shows regime-based
        strategy switching lifts win rate by 10-20 pp vs static single-strategy.
        ADX > 25 = strong trend → mean reversion statistically unsafe.
        ADX < 20 = strong range → breakout entries fail (R:R becomes negative).
    """
    if df is None or len(df) < 28:
        return {
            "adx": None, "plus_di": None, "minus_di": None,
            "regime": "n/a",
            "adx_threshold_note": "insufficient data (need >=28 bars for 14-ADX)",
        }
    high = df["high"].astype(float)
    low = df["low"].astype(float)
    close = df["close"].astype(float)
    n = len(df)
    # Wilder smoothing over 14 periods
    period = 14
    prev_close = close.shift(1)
    tr = pd.concat([
        (high - low),
        (high - prev_close).abs(),
        (low - prev_close).abs(),
    ], axis=1).max(axis=1)
    # Wilder smoothing: (prev_tr * 13 + tr) / 14, cumulative from first period
    atr_wilder = pd.Series(np.nan, index=df.index)
    if n > period:
        atr_wilder.iloc[period] = tr.iloc[1:period + 1].mean()
        for i in range(period + 1, n):
            atr_wilder.iloc[i] = (atr_wilder.iloc[i - 1] * (period - 1) + tr.iloc[i]) / period
    # +DM / -DM
    up_move = high.diff()
    down_move = -low.diff()
    plus_dm = pd.Series(np.where((up_move > down_move) & (up_move > 0), up_move, 0.0), index=df.index)
    minus_dm = pd.Series(np.where((down_move > up_move) & (down_move > 0), down_move, 0.0), index=df.index)
    # Wilder smooth the DMs
    plus_dm_w = pd.Series(np.nan, index=df.index)
    minus_dm_w = pd.Series(np.nan, index=df.index)
    if n > period:
        plus_dm_w.iloc[period] = plus_dm.iloc[1:period + 1].mean()
        minus_dm_w.iloc[period] = minus_dm.iloc[1:period + 1].mean()
        for i in range(period + 1, n):
            plus_dm_w.iloc[i] = (plus_dm_w.iloc[i - 1] * (period - 1) + plus_dm.iloc[i]) / period
            minus_dm_w.iloc[i] = (minus_dm_w.iloc[i - 1] * (period - 1) + minus_dm.iloc[i]) / period
    # +DI / -DI
    plus_di = 100 * (plus_dm_w / atr_wilder)
    minus_di = 100 * (minus_dm_w / atr_wilder)
    # DX / ADX
    di_sum = (plus_di + minus_di).replace(0, np.nan)
    di_diff = (plus_di - minus_di).abs()
    dx = 100 * (di_diff / di_sum)
    adx_series = pd.Series(np.nan, index=df.index)
    if n > 2 * period:
        adx_series.iloc[2 * period] = dx.iloc[period + 1:2 * period + 1].mean()
        for i in range(2 * period + 1, n):
            adx_series.iloc[i] = (adx_series.iloc[i - 1] * (period - 1) + dx.iloc[i]) / period
    adx_last = float(adx_series.iloc[-1]) if pd.notna(adx_series.iloc[-1]) else None
    plus_di_last = float(plus_di.iloc[-1]) if pd.notna(plus_di.iloc[-1]) else None
    minus_di_last = float(minus_di.iloc[-1]) if pd.notna(minus_di.iloc[-1]) else None
    if adx_last is None:
        regime = "n/a"
    elif adx_last < 20:
        regime = "range"
    elif adx_last <= 25:
        regime = "dead"
    else:
        regime = "trend"
    return {
        "adx": round(adx_last, 2) if adx_last is not None else None,
        "plus_di": round(plus_di_last, 2) if plus_di_last is not None else None,
        "minus_di": round(minus_di_last, 2) if minus_di_last is not None else None,
        "regime": regime,
        "adx_threshold_note": "ADX<20=range, 20-25=dead, >25=trend (Wilder 14)",
    }


