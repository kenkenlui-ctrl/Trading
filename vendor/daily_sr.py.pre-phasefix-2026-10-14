# 3. Support ladder
# =============================================================================

def find_swing_levels(series: pd.Series, order: int = 5, direction: str = "low") -> list[tuple[int, float]]:
    """Find local extrema with given order (window)."""
    arr = series.values
    n = len(arr)
    swings = []
    for i in range(order, n - order):
        window = arr[i - order: i + order + 1]
        if direction == "low" and arr[i] == window.min():
            swings.append((i, float(arr[i])))
        if direction == "high" and arr[i] == window.max():
            swings.append((i, float(arr[i])))
    # Deduplicate close-by same-bar swings
    deduped = []
    for s in swings:
        if not deduped or s[1] != deduped[-1][1]:
            deduped.append(s)
    return deduped


def cluster_levels(levels: list[float], tolerance: float = 0.025) -> list[dict]:
    """Cluster nearby levels. Returns list of {price, count, indices}."""
    if not levels:
        return []
    sorted_lvls = sorted(levels)
    clusters: list[list[float]] = [[sorted_lvls[0]]]
    for lvl in sorted_lvls[1:]:
        centroid = sum(clusters[-1]) / len(clusters[-1])
        if abs(lvl - centroid) / centroid < tolerance:
            clusters[-1].append(lvl)
        else:
            clusters.append([lvl])
    return [
        {"price": round(sum(c) / len(c), 2), "count": len(c)}
        for c in clusters
    ]


def build_support_ladder(df: pd.DataFrame, current: float, peak_price: float, trough_price: float, trough_date_str: str, snap: float = 4.0) -> list[dict]:
    """Build support ladder from base-period lows (histogram approach).

    Strategy: 4-tier ladder, analyst-style:
    - S1 KEY = highest tested support zone (most touches)
    - S2, S3 = next tested zones
    - S4 = crash low (structural bottom)

    Levels are snapped to clean numbers (default snap=4, ~even integers).
    """
    def snap_to(v: float) -> float:
        return round(v / snap) * snap

    from collections import Counter

    trough_date = pd.to_datetime(trough_date_str)
    base = df[df["date"] >= trough_date].reset_index(drop=True)
    if len(base) < 10:
        base = df.tail(60).reset_index(drop=True)

    # 1) Use ALL base-period lows (not just swing lows) to find tested zones
    base_low_prices = base["low"].tolist()
    # Also include swing lows from the FULL data within the last 30 days
    # (captures very recent structural tests)
    recent30 = df.tail(30)
    base_low_prices.extend(recent30["low"].tolist())

    snapped_lows = [snap_to(p) for p in base_low_prices if p < current * 0.98]
    counter = Counter(snapped_lows)

    # 2) Sort by count descending, then by price descending
    tested_levels_raw = sorted(
        counter.items(),
        key=lambda x: (-x[1], -x[0]),
    )

    # 3) Greedy pick: take top N with min separation
    min_sep = snap
    min_touches = 3  # require at least 3 touches for a "real" support
    tested_levels = []
    for lvl, cnt in tested_levels_raw:
        if cnt < min_touches:
            continue
        if all(abs(lvl - existing) >= min_sep for existing, _ in tested_levels):
            tested_levels.append((lvl, cnt))
        if len(tested_levels) >= 5:
            break

    # 4) Filter out "weak adjacent" levels: if a level is within 2*snap of a
    # stronger neighbor, drop it. Keeps 160/152/148 (drops 156).
    if len(tested_levels) > 1:
        tested_levels.sort(key=lambda x: -x[0])
        filtered = []
        for i, (lvl, cnt) in enumerate(tested_levels):
            max_neighbor = 0
            for j, (other_lvl, other_cnt) in enumerate(tested_levels):
                if i == j:
                    continue
                if abs(other_lvl - lvl) <= 2 * snap:
                    max_neighbor = max(max_neighbor, other_cnt)
            if max_neighbor == 0 or cnt >= max_neighbor * 0.3:
                filtered.append((lvl, cnt))
        tested_levels = filtered

    # 4) S1 KEY: highest tested level below current
    if tested_levels:
        tested_levels.sort(key=lambda x: -x[0])  # by price desc
        s1_price, s1_touches = tested_levels[0]
    else:
        s1_price = snap_to(current * 0.97)
        s1_touches = 0

    s1_evidence_parts = []
    if s1_touches >= 2:
        s1_evidence_parts.append(f"tested {s1_touches}x in base period")
    else:
        s1_evidence_parts.append("structural level near current")
    s1_evidence_parts.append(f"{((current - s1_price) / current * 100):.1f}% below current")

    supports: list[dict] = [{
        "level": float(s1_price), "label": "S1 KEY", "touches": s1_touches,
        "evidence": "; ".join(s1_evidence_parts),
    }]

    # 5) S2, S3: next tested levels below S1
    for lvl, cnt in tested_levels[1:]:
        if len(supports) >= 3:
            break
        label = f"S{len(supports) + 1}"
        supports.append({
            "level": float(lvl), "label": label, "touches": cnt,
            "evidence": f"mid-base support, tested {cnt}x",
        })

    # 6) Add crash low as the bottom S (always include, but relabel as S bottom
    #    if it's too close to the existing S3)
    if trough_price < supports[-1]["level"] * 0.95:
        # Crash low is meaningfully below S3 — keep both, label as S4
        supports.append({
            "level": float(trough_price), "label": "S4 crash low",
            "touches": 1, "evidence": f"crash low {trough_date_str}, structural bottom",
        })
    else:
        # Crash low is too close to the existing lowest S — combine
        supports[-1]["label"] = f"S{len(supports)} bottom"
        supports[-1]["evidence"] = f"structural bottom, near crash low {trough_price}"

    supports.sort(key=lambda s: -s["level"])
    return supports


# =============================================================================
# 4. Resistance ladder
# =============================================================================

def build_resistance_ladder(df: pd.DataFrame, current: float, peak_price: float, peak_date: str, trough_price: float, trough_date: str, box_top_price: float, box_top_date: str, snap: float = 1.0) -> list[dict]:
    """Build resistance ladder.

    Strategy: 5-tier ladder, analyst-style:
    - R1 = today's high (immediate supply)
    - R2 = mid-box round number
    - R3 = box top (June high, etc.)
    - R4 = pre-crash round number
    - R5 = pre-crash supply zone (top of breakdown)
    """
    def snap_to(v: float) -> float:
        return round(v / snap) * snap

    resistances: list[dict] = []

    # R1: today's high
    today = df.iloc[-1]
    r1_price = float(today["high"])
    today_range = today["high"] - today["low"]
    upper_wick = today["high"] - max(today["open"], today["close"])
    if upper_wick > today_range * 0.5 and today["close"] < today["open"]:
        r1_evidence = f"rejection at {r1_price} (long upper wick, close weak)"
    else:
        r1_evidence = f"today's high {r1_price}"
    resistances.append({
        "level": round(r1_price, 2), "label": "R1 today high", "evidence": r1_evidence,
    })

    # R3: box top (snapped if close to a round number)
    if box_top_price > r1_price * 1.005 and box_top_price > current * 1.005:
        box_top_dt = pd.to_datetime(box_top_date)
        # Keep box top as actual value (don't snap — it's a specific date high)
        resistances.append({
            "level": round(box_top_price, 2),
            "label": f"R3 {box_top_dt.strftime('%b')} high",
            "evidence": f"box top {box_top_price}, base period high",
        })

    # R2: round number between R1 and R3 (prefer multiples of 10)
    r3_price = box_top_price
    if r3_price > r1_price * 1.02:
        r2_candidate = None
        # Prefer round multiples of 10
        for cand in [200, 190, 180, 170, 160, 150, 140, 130, 120]:
            if r1_price * 1.005 < cand < r3_price * 0.99:
                r2_candidate = cand
                break
        if r2_candidate is None:
            # Fall back to multiples of 5
            for cand in [195, 185, 175, 165, 155, 145, 135]:
                if r1_price * 1.005 < cand < r3_price * 0.99:
                    r2_candidate = cand
                    break
        if r2_candidate is not None:
            resistances.append({
                "level": float(r2_candidate), "label": "R2",
                "evidence": f"mid-box supply, round number {r2_candidate}",
            })

    # R4: round number in pre-crash zone, above current * 1.20
    pre_crash_candidates: list[float] = []
    for cand in [200, 195, 190, 185, 180, 175, 170, 165, 160, 155, 150]:
        if current * 1.20 < cand < peak_price * 0.97 and cand > trough_price * 1.20:
            pre_crash_candidates.append(cand)

    # Exclude levels already used (R1, R2, R3)
    existing = {r["level"] for r in resistances}
    r4_candidates = [c for c in pre_crash_candidates if c not in existing]
    if r4_candidates:
        r4_candidate = min(r4_candidates)  # smallest above current*1.20
        resistances.append({
            "level": float(r4_candidate), "label": "R4",
            "evidence": f"psychological round number, pre-crash zone {r4_candidate}",
        })

    # R5: pre-crash supply near the breakdown
    # Find swing highs in the 20 days BEFORE the crash
    trough_date_dt = pd.to_datetime(trough_date)
    pre_window = df[(df["date"] >= trough_date_dt - pd.Timedelta(days=25))
                    & (df["date"] <= trough_date_dt)]
    if not pre_window.empty:
        pre_highs = find_swing_levels(pre_window["high"], order=3, direction="high")
        if pre_highs:
            top_highs = sorted(pre_highs, key=lambda x: -x[1])[:3]
            r5_candidate_raw = float(np.mean([h[1] for h in top_highs]))
            # Snap to nearest 5 for R5
            r5_candidate = round(r5_candidate_raw / 5) * 5
            if (r5_candidate > current * 1.15
                    and not any(abs(r["level"] - r5_candidate) < r5_candidate * 0.04 for r in resistances)):
                resistances.append({
                    "level": float(r5_candidate), "label": "R5",
                    "evidence": f"pre-crash supply, top before breakdown",
                })

    # Sort ascending
    resistances.sort(key=lambda r: r["level"])
    return resistances


