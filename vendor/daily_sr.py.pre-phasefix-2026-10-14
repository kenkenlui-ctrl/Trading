#
# Guard: when ATR14 ≥ VOL_GUARD_ATR_PCT (% of price) OR the 20-day box width
# ≥ VOL_GUARD_BOX_PCT (% of price), demote inside-box strategies
# (SELL_R1 / BUY_S1) to WAIT_VOLATILE. Breakout strategies stay allowed — they
# trade WITH momentum and are not mean-reversion knife-catching.
#
# Calibration (2026-08-25, HK liquid names): 0700 2.7%/14%, 0005 1.4%/7%,
# 3690 4.2%/25%, 9988 4.5%/18%, 9618 3.7%/19% — all pass; 6869 7.6%/46% blocked.
VOL_GUARD_ATR_PCT = 6.0
VOL_GUARD_BOX_PCT = 35.0
# Stop distance for inside-box plans: never tighter than 1.5 × ATR14.
STOP_ATR_MULT = 1.5
# R:R floor after widening stops — below this the plan is not worth taking.
RR_FLOOR = 1.2


