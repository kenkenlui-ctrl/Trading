# =============================================================================
# CJK font resolution (2026-10-11) — company names rendered as tofu boxes
# =============================================================================
# The chart used to hardcode "DejaVu Sans", which has zero CJK coverage, so every
# Chinese company name (騰訊控股 / 阿里巴巴 ...) drew as □□□□ in the title AND the
# footer source line. matplotlib >= 3.6 supports a font *list* as true glyph
# fallback: first family that has the glyph wins. So keep DejaVu Sans first (it
# gives the existing clean Latin/numeric look) and append a CJK family behind it.
# Chinese glyphs fall through to the CJK face; Latin never leaves DejaVu Sans.

CJK_FONT_CANDIDATES = [
    "PingFang HK",       # macOS default TC
    "PingFang TC",
    "Heiti TC",          # STHeiti, present on most macOS installs
    "Hiragino Sans GB",
    "Arial Unicode MS",  # ships with Office / macOS supplemental
    "Songti SC",
    "Noto Sans CJK TC",
    "Microsoft JhengHei",
]

_LATIN_FONT = "DejaVu Sans"


def resolve_font_family():
    """Return a matplotlib font.family list: Latin first, CJK fallback behind.

    Returns just [LATIN] when no CJK family is installed, which reproduces the
    old tofu behaviour rather than raising — a missing font must never stop a
    chart from being produced.
    """
    try:
        from matplotlib import font_manager
        available = {f.name for f in font_manager.fontManager.ttflist}
    except Exception:
        return [_LATIN_FONT]
    cjk = [name for name in CJK_FONT_CANDIDATES if name in available]
    return [_LATIN_FONT] + cjk

