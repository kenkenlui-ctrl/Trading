# 5. Position + K-line behavior
# =============================================================================

def analyze_position(df: pd.DataFrame, current: float, supports: list[dict], resistances: list[dict]) -> dict:
    """Where is current price relative to the S/R ladder?"""
    nearest_support = supports[0] if supports else None
    nearest_resistance = next((r for r in resistances if r["level"] > current), None)

    # Box position %: from crash low (deepest support) to box top (R3 or highest R)
    box_bottom = supports[-1]["level"] if supports else current * 0.85
    # Find the box top: prefer R3 (box top), then highest R
    box_top_candidates = [r["level"] for r in resistances if r["label"].startswith("R3")]
    if not box_top_candidates:
        box_top_candidates = [r["level"] for r in resistances if r["label"].startswith("R")]
    box_top = max(box_top_candidates) if box_top_candidates else current * 1.15

    if box_top > box_bottom:
        in_box_pct = (current - box_bottom) / (box_top - box_bottom) * 100
    else:
        in_box_pct = 50.0
    in_box_pct = max(0.0, min(100.0, in_box_pct))

    return {
        "current": round(current, 2),
        "in_box_pct": round(in_box_pct, 1),
        "nearest_support": f"{nearest_support['label']} ({nearest_support['level']})" if nearest_support else None,
        "nearest_resistance": f"{nearest_resistance['label']} ({nearest_resistance['level']})" if nearest_resistance else None,
    }


def analyze_kline_behavior(df: pd.DataFrame, supports: list[dict], resistances: list[dict]) -> dict:
    """Today's K-line behavior vs the nearest S/R levels."""
    today = df.iloc[-1]
    O, H, L, C = float(today["open"]), float(today["high"]), float(today["low"]), float(today["close"])
    rng = H - L
    if rng == 0:
        rng = 0.01

    upper_wick = H - max(O, C)
    lower_wick = min(O, C) - L
    body = abs(C - O)

    touched_R1 = H >= (resistances[0]["level"] * 0.998) if resistances else False
    touched_S1 = L <= (supports[0]["level"] * 1.002) if supports else False

    # Classification
    if C > O and body > rng * 0.6 and not touched_S1:
        ktype = "bullish_reclaim"
    elif upper_wick > body * 1.5 and C < O:
        ktype = "bearish_rejection"
    elif lower_wick > body * 1.5 and C > O:
        ktype = "bullish_hold"
    elif C < O and not touched_S1:
        ktype = "bearish_pullback"
    else:
        ktype = "neutral"

    close_pos = "upper_half" if C > (H + L) / 2 else "lower_half"

    return {
        "type": ktype,
        "touched_R1": touched_R1,
        "touched_S1": touched_S1,
        "close_position": close_pos,
        "O": round(O, 2), "H": round(H, 2), "L": round(L, 2), "C": round(C, 2),
        "body_pct": round(body / rng * 100, 1),
        "upper_wick_pct": round(upper_wick / rng * 100, 1),
        "lower_wick_pct": round(lower_wick / rng * 100, 1),
    }


