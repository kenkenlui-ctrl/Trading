def normalize_ticker(ticker: str) -> tuple[str, str]:
    """Convert user input to (futu_code, yfinance_code)."""
    t = ticker.strip().upper()
    if t.startswith(("HK.", "US.", "SH.", "SZ.")):
        return t, t.split(".", 1)[1]
    if t.endswith(".HK"):
        digits = t[:-3]
        if digits.isdigit():
            return f"HK.{int(digits):05d}", f"{int(digits):04d}.HK"
    if re.fullmatch(r"\d{1,5}", t):
        return f"HK.{int(t):05d}", f"{int(t):04d}.HK"
    # JP ticker (digits + .T / .JP) — yfinance uses .T suffix
    if re.fullmatch(r"\d{1,5}\.(T|JP)", t):
        digits = re.match(r"(\d+)", t).group(1)
        return f"JP.{digits}", f"{digits}.T"
    # US ticker (letters, possibly with dots like BRK.B)
    if re.fullmatch(r"[A-Z][A-Z0-9.]{0,5}", t):
        return f"US.{t}", t
    # 2026-10-07: class shares written with a HYPHEN (BRK-B, BF-B, HEI-A).
    # The published universe uses this form, and it is ALSO Yahoo's own form —
    # BRK.B returns zero rows, BRK-B returns bars (checked 2026-10-07). The bug
    # was never the mapping, only that normalize_ticker had no branch for a
    # hyphen at all, so it raised "Cannot normalize ticker: BRK-B" and BRK-B
    # silently stopped refreshing: its page fell back to a "數據未更新" banner
    # dated 2026-09-03 while a separately-fetched chart series was still drawn
    # out to 2026-10-02. Do NOT "fix" this by rewriting the hyphen to a dot.
    if re.fullmatch(r"[A-Z][A-Z0-9]*-[A-Z0-9]", t):
        return f"US.{t}", t
    raise ValueError(f"Cannot normalize ticker: {ticker}")


def fetch_ohlc(ticker: str, days: int = 200, source: str = "auto", asof: str | None = None) -> tuple[pd.DataFrame, str, str]:
    """Returns (df, source, stock_name) where source is 'futu' or 'yfinance'.

    asof: trim to T-1 (yesterday's close) by default. Pass YYYY-MM-DD to override.
    """
    # 2026-09-29: the fetch end date was date.today(). yfinance treats `end`
    # as EXCLUSIVE, so today's bar was never returned at all — and
    # trim_to_t_minus_1(None) then strips it anyway, losing the latest session
    # twice over. Futu treats `end` as INCLUSIVE and rejects a future date, so
    # the extra day must be added only on the yfinance path (see below).
    end = date.today()
    start = end - timedelta(days=int(days * 1.6))
    futu_code, yf_code = normalize_ticker(ticker)

    if source == "yfinance":
        # yfinance `end` is exclusive -> ask for the day after so today is
        # included. Futu is inclusive and 400s on a future date, so it does
        # NOT get this treatment.
        df, name = fetch_yfinance(yf_code, start.isoformat(),
                                  (end + timedelta(days=1)).isoformat())
        df = trim_to_t_minus_1(df, asof=asof)
        return df.tail(days).reset_index(drop=True), "yfinance", name
    elif source == "futu":
        df, name = fetch_futu(futu_code, start.isoformat(), end.isoformat())
        df = trim_to_t_minus_1(df, asof=asof)
        return df.tail(days).reset_index(drop=True), "futu", name
    try:
        df, name = fetch_futu(futu_code, start.isoformat(), end.isoformat())
        if len(df) < 20:
            raise RuntimeError(f"futu returned only {len(df)} rows")
        df = trim_to_t_minus_1(df, asof=asof)
        return df.tail(days).reset_index(drop=True), "futu", name
    except Exception as e:
        print(f"  futu failed ({type(e).__name__}: {e}), trying yfinance", file=sys.stderr)
        # 2026-10-14: the +1 day is missing here, and it is the exact bug the
        # comment at the top of this function warns about. yfinance treats
        # `end` as EXCLUSIVE, so passing bare `end` never returns the current
        # session — and the explicit `source="yfinance"` branch above adds the
        # day precisely for that reason. So the auto path, whenever futu was
        # unreachable, silently lost the newest bar while the same ticker via
        # the explicit path had it: HK and JP snapshots stamped one session
        # behind the OHLC series built from the explicit path, i.e. two data
        # dates on one page. Futu being down is exactly when the fallback runs,
        # so the two paths could never agree during an outage.
        df, name = fetch_yfinance(yf_code, start.isoformat(),
                                  (end + timedelta(days=1)).isoformat())
        df = trim_to_t_minus_1(df, asof=asof)
        return df.tail(days).reset_index(drop=True), "yfinance", name


def fetch_futu(futu_code: str, start: str, end: str) -> tuple[pd.DataFrame, str]:
    """Fetch daily OHLC + stock name from Futu OpenD."""
    from futu import OpenQuoteContext, KLType, RET_OK
    ctx = OpenQuoteContext(host="127.0.0.1", port=11111)
    try:
        ret, data, _ = ctx.request_history_kline(
            futu_code, start=start, end=end,
            ktype=KLType.K_DAY, max_count=1000,
        )
        if ret != RET_OK:
            raise RuntimeError(f"futu error: {data}")
        df = data.rename(columns={"time_key": "date"}).copy()
        df["date"] = pd.to_datetime(df["date"]).dt.tz_localize(None)
        # Extract name from the first row
        name = str(data["name"].iloc[0]) if "name" in data.columns else ""
        return df[["date", "open", "high", "low", "close", "volume"]].reset_index(drop=True), name
    finally:
        ctx.close()


def fetch_yfinance(yf_code: str, start: str, end: str) -> tuple[pd.DataFrame, str]:
    """Fallback: yfinance."""
    import yfinance as yf
    try:
        ticker_obj = yf.Ticker(yf_code)
        name = ticker_obj.info.get("shortName") or ticker_obj.info.get("longName") or ""
    except Exception:
        name = ""
    data = yf.download(yf_code, start=start, end=end, progress=False, auto_adjust=False)
    if data.empty:
        raise RuntimeError(f"yfinance returned no data for {yf_code}")
    data = data.reset_index()
    if isinstance(data.columns, pd.MultiIndex):
        data.columns = [c[0].lower() if isinstance(c, tuple) else c.lower() for c in data.columns]
    else:
        data.columns = [c.lower() for c in data.columns]
    keep = ["date", "open", "high", "low", "close", "volume"]
    for k in keep:
        if k not in data.columns:
            raise RuntimeError(f"yfinance missing column: {k}")
    return data[keep].reset_index(drop=True), name


def trim_to_t_minus_1(df: pd.DataFrame, asof: str | None = None) -> pd.DataFrame:
    """Drop the last bar if its date is today (intraday). Use T-1 close by default.

    asof: explicit date string YYYY-MM-DD — trim to data up to that date (inclusive).
    """
    if df.empty:
        return df
    if asof:
        target = pd.to_datetime(asof)
        df = df[df["date"] <= target].reset_index(drop=True)
    else:
        # Default: drop last bar if it's today (in HK timezone)
        from datetime import datetime, timezone
        now_hk = datetime.now(timezone.utc).astimezone()  # system local
        # Try HK timezone
        try:
            from zoneinfo import ZoneInfo
            now_hk = datetime.now(ZoneInfo("Asia/Hong_Kong"))
        except Exception:
            pass
        today = now_hk.date()
        last_date = pd.to_datetime(df["date"].iloc[-1]).date() if hasattr(df["date"].iloc[-1], 'date') else df["date"].iloc[-1]
        if last_date == today:
            df = df.iloc[:-1].reset_index(drop=True)
    return df


