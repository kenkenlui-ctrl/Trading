# Performance: cache-control headers (Phase 9+, 2026-07-21)
# Static HTML pages: 5 min cache (frequent content, can change
# if user runs backfill). With must-revalidate, browser re-checks
# ETag on every visit (cheap), but CDN edge serves cached copy.

# Dashboard per-date pages: 5 min cache
/dashboard/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Hub + Full Results + Live Monitor (regenerated each build, 5 min OK)
/full-results.html
  Cache-Control: public, max-age=300, must-revalidate
/dashboard/
  Cache-Control: public, max-age=300, must-revalidate

# Per-ticker report pages
/dashboard/*/reports/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Live monitor
/live-monitor.html
  Cache-Control: public, max-age=60, must-revalidate

# Static info pages
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Shared CSS
/leeks.css
  Cache-Control: public, max-age=86400, must-revalidate

# Chart PNGs — short cache so browser/CDN always revalidates after deploy
# (cache-bust query string also added)
/hk200/charts/*.png
  Cache-Control: public, max-age=300, must-revalidate
/us200/charts/*.png
  Cache-Control: public, max-age=300, must-revalidate
