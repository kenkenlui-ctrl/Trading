# =========================================================
# LEEKS TERMINAL — Cache-Control policy
# v4 (2026-08-25 P1 fix)
#
# Policy:
#   HTML  → max-age=0 must-revalidate (content changes daily after close)
#   CSS   → 300s; cache-busted via ?v= query param on every deploy
#   PNGs  → 300s; cache-busted via ?v=T-1-date query param
#
# v4 note: v3 used exact path "/leeks.css" which Cloudflare Pages
# matched only for the no-query variant. Adding wildcard "/leeks*" so
# both "/leeks.css" and "/leeks.css?v=..." honor the 300s rule.
# Same fix applied to PNG paths.
# =========================================================

# HTML — must-revalidate so daily data refresh is visible immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/*
  Cache-Control: public, max-age=0, must-revalidate

# Shared CSS — short cache so theme updates roll out fast (?v= busting)
/leeks.css
  Cache-Control: public, max-age=300, must-revalidate
/leeks.css?*
  Cache-Control: public, max-age=300, must-revalidate

# Chart PNGs — short cache; pages reference them with ?v=<T-1 date>
/hk200/charts/*.png
  Cache-Control: public, max-age=300, must-revalidate
/hk200/charts/*.png?*
  Cache-Control: public, max-age=300, must-revalidate
/us200/charts/*.png
  Cache-Control: public, max-age=300, must-revalidate
/us200/charts/*.png?*
  Cache-Control: public, max-age=300, must-revalidate

# OG image — rarely changes
/og-image*
  Cache-Control: public, max-age=86400, must-revalidate
